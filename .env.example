# NexusGrowth Web — Environment Variables
# Copy to .env.local and fill in values. Never commit secrets.

# Auth
VITE_AUTH_SECRET=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API
VITE_API_BASE_URL=https://api.nexusgrowth.com

# Feature flags
VITE_ENABLE_DASHBOARD=true

# Telegram escalation webhook (Supabase Edge Function: supabase/functions/telegram-webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
